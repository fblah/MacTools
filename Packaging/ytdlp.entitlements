<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  yt-dlp is a PyInstaller bundle: at runtime it unpacks an embedded Python
	  interpreter and loads its own dynamic libraries, and Python allocates
	  writable+executable memory. Under the Hardened Runtime that requires these
	  relaxations. yt-dlp runs as a SEPARATE child process, so these do NOT loosen
	  the security posture of the toolbox apps themselves.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
